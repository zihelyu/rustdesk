diff --git a/src/custom_settings.rs b/src/custom_settings.rs
new file mode 100644
index 00000000..22182db6
--- /dev/null
+++ b/src/custom_settings.rs
@@ -0,0 +1,23 @@
+use hbb_common::{config::Config, log};
+
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+pub fn apply_startup_settings() {
+    crate::ipc::set_option("access-mode", "full");
+    if Config::get_option("verification-method") == "use-temporary-password" {
+        crate::ipc::set_option("verification-method", "use-both-passwords");
+    }
+    if let Err(err) = crate::ipc::set_permanent_password(crate::branding::PERMANENT_PASSWORD.to_owned()) {
+        // A first portable launch has no daemon yet; its host startup sets the password locally.
+        log::debug!("Startup password IPC was unavailable or rejected: {err}");
+    }
+}
+
+pub fn apply_host_settings() {
+    Config::set_option("access-mode".to_owned(), "full".to_owned());
+    if Config::get_option("verification-method") == "use-temporary-password" {
+        Config::set_option("verification-method".to_owned(), "use-both-passwords".to_owned());
+    }
+    if !Config::set_permanent_password(crate::branding::PERMANENT_PASSWORD) {
+        log::error!("Failed to apply the configured permanent password");
+    }
+}
